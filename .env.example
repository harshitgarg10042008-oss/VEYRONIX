# =============================================================
# VEYRONIX / ConfigSentinel AI  —  Environment Configuration
# =============================================================
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to version control. It is already in .gitignore.
#
# For local development with no external services, the defaults
# in this file are sufficient. The system works fully offline.
# =============================================================

# ── Frontend ──────────────────────────────────────────────────
# URL the browser uses to reach the backend API.
# In development, the Vite dev server proxies /api → localhost:5000
# so this can remain empty (same-origin). Set it explicitly only
# if running the frontend and backend on different origins.
# NOT SECRET — safe to commit if changed.
VITE_API_BASE_URL=

# ── Backend — API security ────────────────────────────────────
# Optional bearer token to protect all /api/* routes.
# Leave empty for local development (no authentication enforced).
# SECRET — never share or commit the real value.
CONFIGSENTINEL_API_TOKEN=

# Set to "true" to require the bearer token for all API calls.
# Requires CONFIGSENTINEL_API_TOKEN to also be set.
CONFIGSENTINEL_AUTH_REQUIRED=false

# Maximum API requests per minute per IP.
CONFIGSENTINEL_RATE_LIMIT_PER_MINUTE=120

# ── Backend — Local storage ───────────────────────────────────
# Path to the JSONL governance event ledger (approval workflow).
# Default is .configsentinel/events.jsonl in the repo root.
CONFIGSENTINEL_GOVERNANCE_LEDGER=.configsentinel/events.jsonl

# SQLite database URL for durable audit storage and governance.
CONFIGSENTINEL_DATABASE_URL=sqlite:///./.configsentinel/configsentinel.db

# ── Backend — AI configuration ────────────────────────────────
# Set to "offline" for no-key local-only AI mode (recommended).
# The deterministic engine does NOT require AI to function.
# AI only explains evidence — it never overrides verdicts.
CONFIGSENTINEL_LLM_PROVIDER=offline

# Set to "false" to disable AI features entirely (safest default).
CONFIGSENTINEL_LLM_ENABLED=false

# External OpenAI-compatible endpoint (optional).
# Only needed if CONFIGSENTINEL_LLM_PROVIDER != "offline".
CONFIGSENTINEL_LLM_ENDPOINT=

# Model name to use when calling the external provider.
CONFIGSENTINEL_LLM_MODEL=

# Name of the environment variable that holds the API key.
# The key itself is read from that variable, not here.
CONFIGSENTINEL_LLM_API_KEY_ENV=OPENAI_API_KEY

# The actual API key for the external AI provider.
# SECRET — never share or commit.
OPENAI_API_KEY=

# ── Backend — Backup encryption ───────────────────────────────
# Passphrase for encrypting local backup archives.
# Leave empty to disable backup encryption.
# SECRET — never share or commit.
CONFIGSENTINEL_BACKUP_PASSPHRASE=

# ── Backend — Network ports ───────────────────────────────────
# Override default backend port (default: 5000).
# VEYRONIX_API_PORT=5000

# Override backend listen host (default: 127.0.0.1).
# VEYRONIX_API_HOST=127.0.0.1

# ── Enterprise identity (NOT implemented — future work) ───────
# The following variables are placeholders for a future
# identity-backed login flow. They have NO effect in the current
# release. Do not set them expecting authentication to work.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:5000/auth/callback
# SESSION_SECRET=
